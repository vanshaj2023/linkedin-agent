# ───────────────────────────────────────────────────────────────────
# LinkedIn Automation — Environment Configuration
# Copy this file to .env and fill in the values.
# ───────────────────────────────────────────────────────────────────

# ── LLM ────────────────────────────────────────────────────────────
# Groq powers all scoring + writing (notes, comments, job ranking).
GROQ_API_KEY=

# OpenAI is used only for the vision fallback (locate buttons when
# selectors break). Optional but recommended.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# ── Slack ──────────────────────────────────────────────────────────
# Bot token from your Slack app (xoxb-...).
SLACK_BOT_TOKEN=

# Signing secret from Slack app "Basic Information".
# WARNING: if left empty, /slack/commands accepts unsigned requests.
SLACK_SIGNING_SECRET=

# ── Gmail SMTP (optional — for referral emails) ────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── MongoDB ────────────────────────────────────────────────────────
# Local dev:   mongodb://localhost:27017
# Atlas prod:  mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# ── Inngest ────────────────────────────────────────────────────────
# Get these from app.inngest.com → your app → Keys.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ── System Flags ───────────────────────────────────────────────────
# DRY_RUN=true logs intended actions without clicking LinkedIn.
# Keep TRUE for the first 3-5 days.
DRY_RUN=true

# Warm-up week (1-4). Controls daily budgets. New accounts start at 1.
WARMUP_WEEK=1

# ── Targeting ──────────────────────────────────────────────────────
# Comma-separated keywords. No spaces around commas required.
TARGET_KEYWORDS=hiring,software engineer,backend developer
TARGET_JOB_KEYWORDS=backend engineer,software engineer,python developer
TARGET_JOB_LOCATIONS=India,Remote

# Score thresholds (0-100).
AUTO_REPOST_THRESHOLD=90
CONNECTION_THRESHOLD=60
JOB_SLACK_THRESHOLD=70

# ── Your Profile ───────────────────────────────────────────────────
YOUR_NAME=
YOUR_EMAIL=
YOUR_DOMAIN=backend engineering

# ── Applicant Details (Easy Apply forms) ───────────────────────────
APPLICANT_PHONE=
APPLICANT_YOE=2
APPLICANT_ROLE=
APPLICANT_RESUME_PATH=./resume.pdf
APPLICANT_LINKEDIN_URL=
APPLICANT_GITHUB_URL=
APPLICANT_SALARY=Negotiable
APPLICANT_RELOCATE=false
APPLICANT_SPONSORSHIP=false

# ── GitHub Actions trigger (optional — remote scraper path) ────────
GITHUB_TOKEN=
GITHUB_REPO=
